# Local Docker ports
COD_ATLAS_PORT=8080
COD_ATLAS_DEV_PORT=3000

# Wiki importing is intentionally disabled by default. To import from the
# Call of Duty Wiki, copy these hints into .env and provide real maintainer
# contact information in the user agent.
# COD_ATLAS_WIKI_ORIGIN=https://callofduty.fandom.com
# COD_ATLAS_WIKI_USER_AGENT=CoDAtlasWikiImporter/0.1 (you@example.com; https://github.com/time-wasters/cod-atlas)
